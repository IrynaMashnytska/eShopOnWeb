              "defaultValue": "dev",
              "metadata": {
                "description": "Name of the deployment slot"
              }
            },
            "appServicePlanId": {
              "type": "string",
              "metadata": {
                "description": "ID of the App Service Plan to use"
              }
            },
            "apiBaseUrl": {
              "type": "string",
              "metadata": {
                "description": "Absolute base URL of the Public API, including trailing slash"
              }
            },
            "orderItemsReserverUrl": {
              "type": "string",
              "metadata": {
                "description": "Full URL of the OrderItemsReserver HTTP function the Web app calls after an order is created"
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            }
          },
          "variables": {
            "webBaseUrl": "[format('https://{0}.azurewebsites.net/', parameters('webAppName'))]",
            "slotBaseUrl": "[format('https://{0}-{1}.azurewebsites.net/', parameters('webAppName'), parameters('slotName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2022-09-01",
              "name": "[parameters('webAppName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "serverFarmId": "[parameters('appServicePlanId')]",
                "httpsOnly": true,
                "clientAffinityEnabled": false,
                "siteConfig": {
                  "netFrameworkVersion": "v8.0",
                  "alwaysOn": true,
                  "ftpsState": "FtpsOnly",
                  "minTlsVersion": "1.2",
                  "http20Enabled": true,
                  "healthCheckPath": "/liveness",
                  "appSettings": [
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "Production"
                    },
                    {
                      "name": "UseOnlyInMemoryDatabase",
                      "value": "true"
                    },
                    {
                      "name": "REGION",
                      "value": "[parameters('location')]"
                    },
                    {
                      "name": "baseUrls__apiBase",
                      "value": "[parameters('apiBaseUrl')]"
                    },
                    {
                      "name": "baseUrls__webBase",
                      "value": "[variables('webBaseUrl')]"
                    },
                    {
                      "name": "OrderItemsReserver__Url",
                      "value": "[parameters('orderItemsReserverUrl')]"
                    }
                  ]
                }
              }
            },
            {
              "type": "Microsoft.Web/sites/slots",
              "apiVersion": "2022-09-01",
              "name": "[format('{0}/{1}', parameters('webAppName'), parameters('slotName'))]",
              "location": "[parameters('location')]",
              "tags": "[union(parameters('tags'), createObject('slot', parameters('slotName')))]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "serverFarmId": "[parameters('appServicePlanId')]",
                "httpsOnly": true,
                "siteConfig": {
                  "netFrameworkVersion": "v8.0",
                  "alwaysOn": true,
                  "healthCheckPath": "/liveness",
                  "appSettings": [
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "Development"
                    },
                    {
                      "name": "UseOnlyInMemoryDatabase",
                      "value": "true"
                    },
                    {
                      "name": "SLOT_NAME",
                      "value": "[parameters('slotName')]"
                    },
                    {
                      "name": "baseUrls__apiBase",
                      "value": "[parameters('apiBaseUrl')]"
                    },
                    {
                      "name": "baseUrls__webBase",
                      "value": "[variables('slotBaseUrl')]"
                    },
                    {
                      "name": "OrderItemsReserver__Url",
                      "value": "[parameters('orderItemsReserverUrl')]"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
              ]
            },
            {
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2022-09-01",
              "name": "[format('{0}/{1}', parameters('webAppName'), 'slotConfigNames')]",
              "properties": {
                "appSettingNames": [
                  "ASPNETCORE_ENVIRONMENT",
                  "SLOT_NAME",
                  "baseUrls__webBase"
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
              ]
            }
          ],
          "outputs": {
            "webAppId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
            },
            "webAppName": {
              "type": "string",
              "value": "[parameters('webAppName')]"
            },
            "webAppHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2022-09-01').defaultHostName]"
            },
            "slotHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites/slots', parameters('webAppName'), parameters('slotName')), '2022-09-01').defaultHostName]"
            }
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-plan')]",
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('rgName'))]"
      ]
    }
  ],
  "outputs": {
    "summary": {
      "type": "object",
      "value": {
        "resourceGroup": "[variables('rgName')]",
        "publicApi": "[format('https://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-api'), '2025-04-01').outputs.apiHostname.value)]",
        "web": "[format('https://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-web'), '2025-04-01').outputs.webAppHostname.value)]",
        "webSlot": "[format('https://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-web'), '2025-04-01').outputs.slotHostname.value)]",
        "appInsights": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-monitoring'), '2025-04-01').outputs.appInsightsName.value]",
        "functionApp": "[format('https://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-function'), '2025-04-01').outputs.functionHostname.value)]",
        "functionAppName": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-function'), '2025-04-01').outputs.functionAppName.value]",
        "storageAccount": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-storage'), '2025-04-01').outputs.storageAccountName.value]",
        "ordersContainer": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'deploy-storage'), '2025-04-01').outputs.ordersContainerName.value]"
      }
    }
  }
}